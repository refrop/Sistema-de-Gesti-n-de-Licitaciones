# Base de datos (Supabase)
# App (runtime): pooler transaccional, puerto 6543, pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxx:PASS@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones (Prisma CLI).
# Ojo: en este proyecto el pooler de sesión (5432) puede quedar bloqueado por
# firewalls corporativos/ISP; el pooler tx (6543) funciona y es el que usamos.
DIRECT_URL="postgresql://postgres.xxxx:PASS@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=disable"

# Auth
JWT_SECRET="cadena-aleatoria-de-32+-caracteres"
JWT_EXPIRES_IN="8h"

# Seed del primer admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"
# Seed de usuario demo (rol user, para probar 403)
SEED_USER_EMAIL="user@example.com"
SEED_USER_PASSWORD="CambiaEstaClave123!"

# Supabase Storage
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""        # SOLO servidor, nunca al cliente
SUPABASE_BUCKET="proposals"

# Correo — proveedor: resend (default) | brevo
EMAIL_PROVIDER="resend"
# Resend (obligatoria con EMAIL_PROVIDER=resend): sin dominio verificado solo
# entrega al titular de la cuenta (ver README §4)
RESEND_API_KEY="re_..."
# Brevo (obligatoria con EMAIL_PROVIDER=brevo): remitente individual verificado,
# sin dominio propio (ver README §4)
BREVO_API_KEY=""
# Remitente: Resend usa el remitente de la cuenta; Brevo exige
# "Nombre <correo verificado en Brevo>"
EMAIL_FROM="onboarding@resend.dev"

# Cron
CRON_SECRET="otra-cadena-aleatoria"
REMINDER_HOURS="48"

# App
APP_URL="http://localhost:3000"

# Seed del cliente demo (opcional; solo relevante para reproducir el camino
# de Resend sin dominio verificado, que exige enviar al titular)
SEED_CLIENT_EMAIL=""
# Redirige todos los correos al titular (destinatario original en el cuerpo y en
# EmailLog); SOLO aplica con EMAIL_PROVIDER=resend, Brevo ignora esta variable
EMAIL_REDIRECT_TO=""
