generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  user
}

enum TenderStatus {
  borrador
  activa
  finalizada
  por_cobrar
  cobrada
  perdida
}

enum EmailType {
  envio
  recordatorio
}

enum EmailStatus {
  enviado
  fallido
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(user)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdById  String?  @map("created_by")
  updatedById  String?  @map("updated_by")

  @@map("users")
}

model Client {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  taxId       String?  @map("tax_id")
  contactName String?  @map("contact_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")

  tenders Tender[]

  @@index([email])
  @@map("clients")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")

  tenderProducts TenderProduct[]

  @@map("products")
}

model Tender {
  id             String       @id @default(uuid())
  clientId       String       @map("client_id")
  title          String
  description    String?
  maxBudget      Decimal      @map("max_budget") @db.Decimal(12, 2)
  deadline       DateTime     // fecha_limite (timestamptz, UTC)
  status         TenderStatus @default(borrador)

  // Documento de propuesta
  proposalPath   String?      @map("proposal_path") // ruta en el bucket
  proposalUrl    String?      @map("proposal_url")  // URL pública/firmada
  proposalName   String?      @map("proposal_name")
  proposalSize   Int?         @map("proposal_size")

  // Facturación
  invoicedAmount Decimal?     @map("invoiced_amount") @db.Decimal(12, 2)
  invoicedAt     DateTime?    @map("invoiced_at")

  // Control de tiempo
  sentAt         DateTime?    @map("sent_at")
  reminderSentAt DateTime?    @map("reminder_sent_at")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String?      @map("created_by")
  updatedById    String?      @map("updated_by")

  client      Client             @relation(fields: [clientId], references: [id])
  products    TenderProduct[]
  payments    Payment[]
  transitions TenderTransition[]
  emails      EmailLog[]

  @@index([status, deadline])
  @@index([clientId])
  @@map("tenders")
}

model TenderProduct {
  id          String   @id @default(uuid())
  tenderId    String   @map("tender_id")
  productId   String   @map("product_id")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2) // copia del precio al agregar
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")

  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenderId, productId])
  @@map("tender_products")
}

model Payment {
  id          String   @id @default(uuid())
  tenderId    String   @map("tender_id")
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @default(now()) @map("paid_at")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")

  tender Tender @relation(fields: [tenderId], references: [id])

  @@index([tenderId])
  @@map("payments")
}

model TenderTransition {
  id         String        @id @default(uuid())
  tenderId   String        @map("tender_id")
  fromStatus TenderStatus? @map("from_status") // null en la creación
  toStatus   TenderStatus  @map("to_status")
  userId     String?       @map("user_id")      // null = sistema (cron)
  reason     String?                           // "manual" | "vencimiento_automatico" | "saldo_cero"...
  createdAt  DateTime      @default(now()) @map("created_at")

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId, createdAt])
  @@map("tender_transitions")
}

model EmailLog {
  id         String      @id @default(uuid())
  tenderId   String      @map("tender_id")
  type       EmailType
  toEmail    String      @map("to_email")
  providerId String?     @map("provider_id") // id devuelto por Resend (evidencia)
  status     EmailStatus
  error      String?
  createdAt  DateTime    @default(now()) @map("created_at")

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@map("email_logs")
}
